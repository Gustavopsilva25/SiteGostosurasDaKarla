/* Container principal */
.containerLogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

/* Logo */
.logoLogin {
  width: 80px;
  margin-bottom: 20px;
}

/* Card */
.cardLogin {
  background-color: #A02C6D;
  padding: 40px 60px;
  border-radius: 25px;
  text-align: center;
  width: 300px;
}

/* Título */
.cardLogin h2 {
  color: white;
  margin: 15px 0 5px;
  font-size: 20px;
}

/* Inputs */
.cardLogin input {
  width: 100%;
  height: 35px;
  border: none;
  background-color: #d9d9d9;
  margin-bottom: 15px;
  border-radius: 5px;
  padding: 5px;
}

/* Link */
.link {
  color: #ddd;
  font-size: 14px;
  margin-top: 10px;
  cursor: pointer;
}

.link:hover {
  text-decoration: underline;
}
